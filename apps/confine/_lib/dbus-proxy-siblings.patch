 static Filter *match_all[FLATPAK_POLICY_OWN + 1] = { NULL };
 
+/* Every connection through one proxy comes from the same sandbox, so they
+ * may talk to each other: a service in there can then send a signal to the
+ * caller it answers, which is otherwise only allowed to be seen. */
+static gboolean
+flatpak_proxy_has_client_id (FlatpakProxy *proxy,
+                             const char   *unique_id)
+{
+  GList *l;
+
+  for (l = proxy->clients; l != NULL; l = l->next)
+    {
+      FlatpakProxyClient *other = l->data;
+
+      if (g_strcmp0 (other->unique_id, unique_id) == 0)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
 
 static FlatpakPolicy
