+// Guest RAM that has no path, such as a memfd, arrives as a descriptor from whoever listens on a unix socket.
+_Success_(return)
+BOOL LcPluginCreate_RamSocket(_In_ PLC_CONTEXT ctxLC, _Inout_ PDEVICE_CONTEXT_QEMU ctx, _In_ PLC_DEVICE_PARAMETER_ENTRY pPathRam)
+{
+    struct sockaddr_un addr = { 0 };
+    struct msghdr msg = { 0 };
+    struct iovec iov;
+    struct cmsghdr *cmsg;
+    union { char buf[CMSG_SPACE(sizeof(int))]; struct cmsghdr align; } control;
+    char b;
+    int sock = -1, fd = -1;
+    BOOL fResult = false;
+
+    if(!pPathRam->szValue[0] || (strlen(pPathRam->szValue) >= sizeof(addr.sun_path))) { goto fail; }
+    sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if(sock < 0) { goto fail; }
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, pPathRam->szValue);
+    if(connect(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) { goto fail; }
+    iov.iov_base = &b;
+    iov.iov_len = 1;
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.buf;
+    msg.msg_controllen = sizeof(control.buf);
+    if(recvmsg(sock, &msg, MSG_CMSG_CLOEXEC) != 1) { goto fail; }
+    cmsg = CMSG_FIRSTHDR(&msg);
+    if(!cmsg || (cmsg->cmsg_level != SOL_SOCKET) || (cmsg->cmsg_type != SCM_RIGHTS) || (cmsg->cmsg_len != CMSG_LEN(sizeof(int)))) { goto fail; }
+    memcpy(&fd, CMSG_DATA(cmsg), sizeof(int));
+    fResult = DeviceQEMU_MapFd(ctxLC, ctx, fd);
+fail:
+    if(!fResult) {
+        lcprintf(ctxLC, "DEVICE: QEMU: FAIL: No guest memory from socket '%s'.\n", pPathRam->szValue);
+    }
+    if(fd >= 0) { close(fd); }
+    if(sock >= 0) { close(sock); }
+    return fResult;
+}
