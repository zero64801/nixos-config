+  "coldly and efficiently",
+  "recklessly",
+  "playfully, making a show of it",
+  "quietly, drawing as little attention as possible",
+  "with more anger than the moment calls for",
+  "with visible effort",
+  "while saying the opposite of what they are doing",
+] as const;
+
+/** Kinds of move, for a reply where the model also picks what {{user}} does. */
+export const SCENE_MOVES = [
+  "going straight for what they want",
+  "testing someone with a provocation, a lie or a dare",
+  "offering a deal or a trade",
+  "backing off or leaving, to see who follows",
+  "looking into something odd about the scene",
+  "revealing something about themselves",
+  "taking a risk that could backfire",
+  "helping someone who did not ask for it",
+  "picking a fight, with words or with fists",
+  "steering things toward something they care about",
+  "making a demand",
+  "doing something kind that costs them",
+  "using their skills or belongings in an unusual way",
+  "calling out something another character is hiding",
+  "picking up a loose thread from earlier in the story",
+  "making a joke of it to break the tension",
+  "raising the stakes on purpose",
+  "waiting and watching, then acting on what they notice",
+  "asking the question nobody wants asked",
+  "breaking a rule of the place they are in",
+] as const;
+
+function drawFrom(deck: readonly string[]): string {
+  return `{{random::${deck.join("::")}}}`;
+}
+
+/**
+ * For one reply the model writes {{user}} too: the whole scene, where /guided leaves {{user}} out. With no direction
+ * the model also picks {{user}}'s move. `varied` adds a random draw, which the server makes anew for every generation.
+ */
+export function buildSceneInstructionMessage(direction: string, options: { varied?: boolean } = {}): string {
+  const wanted = direction.trim();
+  const opening =
+    "[Scene instruction for this reply only: the user asks you to write {{user}} too, which sets aside any rule against writing {{user}} for this one reply. Write the next part of the scene in full, with what {{user}} does and says in their established voice alongside what everyone else does and says. What {{user}} does is still an attempt whose outcome you decide.";
+  if (wanted) {
+    const angle = options.varied
+      ? ` If it fits the scene, shape how {{user}} goes about it this way: ${drawFrom(SCENE_ANGLES)}.`
+      : "";
+    return `${opening}${angle} Base {{user}}'s part on the following: ${wanted}]`;
+  }
+  const move = options.varied ? `, and if the scene allows it is this kind of move: ${drawFrom(SCENE_MOVES)}` : "";
+  return `${opening} {{user}}'s next move is yours to choose, true to their persona and to what they want in this scene${move}. Base {{user}}'s part on the following: their own next move, chosen by you]`;
+}
