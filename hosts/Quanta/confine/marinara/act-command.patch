+/** /act and /act!: one AI reply that carries the whole scene, {{user}}'s part included. */
+async function writeScene(args: string, ctx: SlashCommandContext, varied: boolean): Promise<SlashCommandResult> {
+  // One merged reply carries the scene; a manual reply order has no single author for it.
+  if (ctx.requiresManualGuideTarget)
+    return { handled: true, feedback: "/act writes one shared scene, so it needs an automatic reply order." };
+  await ctx.generate({
+    chatId: ctx.chatId,
+    connectionId: null,
+    generationGuide: buildSceneInstructionMessage(args, { varied }),
+    generationGuideSource: "narrator",
+  });
+  return { handled: true };
+}
