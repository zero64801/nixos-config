diff --git a/scripts/regressions/advanced-memory-rollover-drain.regression.ts b/scripts/regressions/advanced-memory-rollover-drain.regression.ts
new file mode 100644
index 0000000..91bb93e
--- /dev/null
+++ b/scripts/regressions/advanced-memory-rollover-drain.regression.ts
@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+// A rollover used to jump to the newest closed scene, leaving only the current scene verbatim, and one long open
+// scene was never recapped, only cut as raw excerpts. A rollover now drains to a target and keeps recent recapped
+// scenes, and an oversized open scene is split so its older part is recapped before a cut needs it.
+const directory = mkdtempSync(join(tmpdir(), "marinara-rollover-drain-"));
+process.env.DATA_DIR = directory;
+process.env.FILE_STORAGE_DIR = join(directory, "storage");
+process.env.NODE_ENV = "test";
+process.env.LOG_LEVEL = "silent";
+process.env.MARINARA_LITE = "true";
+
+const provider = createServer(async (request, response) => {
+  const chunks: Buffer[] = [];
+  for await (const chunk of request) chunks.push(Buffer.from(chunk));
+  const body = JSON.parse(Buffer.concat(chunks).toString());
+  response.setHeader("content-type", "application/json");
+  if (request.url === "/v1/systemone") {
+    const answers = Object.fromEntries(
+      Object.entries(body.questions).map(([id, value]) => {
+        const message = body.state.transcript?.find((item: { messageId: string }) => item.messageId === id);
+        const cut = (value as { instructions: string }).instructions.includes("cut to a new scene");
+        return [id, { type: "noul", noul: cut && message?.content.startsWith("SCENE_CHANGE") ? 0.99 : 0.01 }];
+      }),
+    );
+    response.end(JSON.stringify({ answers }));
+    return;
+  }
+  response.end(
+    JSON.stringify({
+      choices: [
+        {
+          message: {
+            role: "assistant",
+            content: JSON.stringify({ audience: "all", summary: "Mari and Kaito talked." }),
+          },
+          finish_reason: "stop",
+        },
+      ],
+    }),
+  );
+});
+
+const { createFileNativeDB } = await import("../../packages/server/src/db/file-backed-store.js");
+const { createChatsStorage } = await import("../../packages/server/src/services/storage/chats.storage.js");
+const { createConnectionsStorage } = await import("../../packages/server/src/services/storage/connections.storage.js");
+const { createAdvancedMemoryService } = await import("../../packages/server/src/services/advanced-memory.js");
+const db = await createFileNativeDB();
+const chats = createChatsStorage(db);
+const connections = createConnectionsStorage(db);
+const memory = createAdvancedMemoryService(db);
+
+const long = (label: string) => `${label} ${"Mari and Kaito keep walking along the old river road. ".repeat(40)}`;
+
+try {
+  await new Promise<void>((resolve) => provider.listen(0, "127.0.0.1", resolve));
+  const address = provider.address();
+  assert(address && typeof address === "object");
+  const base = `http://127.0.0.1:${address.port}`;
+  const helper = await connections.create({
+    name: "Summary helper",
+    provider: "custom",
+    baseUrl: `${base}/v1`,
+    model: "summary",
+    apiKey: "fixture",
+    maxContext: 65000,
+  });
+  const decision = await connections.create({
+    name: "Jev",
+    provider: "decision",
+    decisionSource: "custom",
+    baseUrl: base,
+    model: "jev-latest",
+    apiKey: "",
+    maxStateTokens: 30000,
+  });
+
+  const createChat = async (name: string, maxContextTokens: number) => {
+    const chat = await chats.create({ name, mode: "roleplay", characterIds: ["kaito"], connectionId: helper.id });
+    assert(chat);
+    await memory.updateSettings(chat.id, {
+      enabled: true,
+      maxContextTokens,
+      summaryBudgetTokens: 512,
+      sceneCheckInterval: 4,
+      decisionEnabled: true,
+      decisionConnectionId: decision.id,
+      knowledgeStarts: { kaito: null },
+      knowledgeConfirmed: true,
+    });
+    return chat;
+  };
+  /** Six scenes of three long messages each; the first message of every scene marks the cut. */
+  const sixScenes = () =>
+    Array.from({ length: 6 }, (_, scene) => [
+      { role: "user" as const, content: long(`SCENE_CHANGE Scene ${scene} opens.`) },
+      { role: "assistant" as const, characterId: "kaito", content: long(`Kaito answers in scene ${scene}.`) },
+      { role: "user" as const, content: long(`Mari replies in scene ${scene}.`) },
+    ]).flat();
+  const sceneStart = (messages: { id: string; content: string }[], scene: number) =>
+    messages.find((message) => message.content.startsWith(`SCENE_CHANGE Scene ${scene} `))!.id;
+
+  // A per-request rollover keeps the newest recapped scenes that fit the drain target, not only the open scene.
+  const prepareChat = await createChat("Drained rollover", 65000);
+  await chats.createMessagesBatch(prepareChat.id, sixScenes());
+  await memory.initialize(prepareChat.id);
+  const summarized = (await memory.status(prepareChat.id)).records.filter(
+    (record) => record.kind === "scene" && record.content,
+  );
+  assert.equal(summarized.length, 5, "the five finished scenes are recapped");
+  const prepareSource = await chats.listMessages(prepareChat.id);
+  const prepared = await memory.prepare({
+    chatId: prepareChat.id,
+    messages: prepareSource,
+    audienceCharacterIds: ["kaito"],
+    budgetTokens: 6200,
+  });
+  assert.ok(prepared.receipt.reasons.includes("scene-boundary-rollover"), "the full history exceeds the budget");
+  assert.equal(
+    prepared.messageIds[0],
+    sceneStart(prepareSource, 4),
+    "the live window keeps the newest finished scene verbatim along with the open one",
+  );
+  assert.ok(!prepared.messageIds.includes(sceneStart(prepareSource, 3)), "older scenes leave for their recaps");
+
+  // The cutoff saved after an oversized reply drains the same way instead of jumping to the newest scene.
+  const resetChat = await createChat("Drained reset", 12000);
+  await chats.createMessagesBatch(resetChat.id, sixScenes());
+  await memory.initialize(resetChat.id);
+  const resetSource = await chats.listMessages(resetChat.id);
+  await memory.checkScenesAfterGeneration(resetChat.id, {
+    maxRequestInputTokens: 12000,
+    asOfMessageId: resetSource.at(-1)!.id,
+  });
+  const starts = (await memory.status(resetChat.id)).job.contextStarts;
+  assert.equal(starts?.length, 1, "an input at the cap saves a cutoff");
+  assert.notEqual(starts![0]!.messageId, sceneStart(resetSource, 5), "the cutoff no longer keeps only the open scene");
+  assert.ok(
+    [2, 3, 4].some((scene) => starts![0]!.messageId === sceneStart(resetSource, scene)),
+    "the cutoff lands on an earlier scene start that fits the drain target",
+  );
+
+  // One long open scene is split once it outgrows half the cap, and its older part is recapped.
+  const splitChat = await createChat("Forced split", 12000);
+  await chats.createMessagesBatch(
+    splitChat.id,
+    Array.from({ length: 16 }, (_, index) => ({
+      role: index % 2 ? ("assistant" as const) : ("user" as const),
+      ...(index % 2 ? { characterId: "kaito" } : {}),
+      content: long(`Turn ${index} of one long walk.`),
+    })),
+  );
+  await memory.initialize(splitChat.id);
+  assert.equal(
+    (await memory.status(splitChat.id)).records.filter(
+      (record) => record.kind === "scene" && record.status === "closed",
+    ).length,
+    0,
+    "nothing marks a scene change, so the whole walk is one open scene",
+  );
+  // One by one, as replies arrive, so they sort after the prepared history.
+  for (let index = 0; index < 4; index++)
+    await chats.createMessage({
+      chatId: splitChat.id,
+      role: index % 2 ? "assistant" : "user",
+      ...(index % 2 ? { characterId: "kaito" } : {}),
+      content: long(`Later turn ${index} of the same walk.`),
+    });
+  const splitSource = await chats.listMessages(splitChat.id);
+  assert.ok(splitSource.at(-1)!.content.startsWith("Later turn 3 "), "the new turns come last");
+  await memory.checkScenesAfterGeneration(splitChat.id, { asOfMessageId: splitSource.at(-1)!.id });
+  const records = (await memory.status(splitChat.id)).records.filter((record) => record.kind === "scene");
+  const closedRecap = records.find((record) => record.status === "closed" && record.content);
+  assert.ok(closedRecap, "the older part of the walk is closed and recapped");
+  const open = records.find((record) => record.status === "open");
+  assert.ok(open, "the recent part stays open");
+  const openStart = splitSource.findIndex((message) => message.id === open!.startMessageId);
+  assert.equal(splitSource[openStart]!.role, "user", "the open part starts on a user message");
+  assert.ok(splitSource.length - openStart >= 4, "the open part keeps several messages verbatim");
+  assert.ok(openStart >= 4, "the recapped part keeps several messages");
+  console.log("advanced memory rollover drain regression passed");
+} finally {
+  provider.close();
+  rmSync(directory, { recursive: true, force: true });
+}
diff --git a/scripts/regressions/advanced-memory-story-state.regression.ts b/scripts/regressions/advanced-memory-story-state.regression.ts
new file mode 100644
index 0000000..1790293
--- /dev/null
+++ b/scripts/regressions/advanced-memory-story-state.regression.ts
@@ -0,0 +1,215 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+// Scene recaps are historical by design, so lasting facts (where people are, injuries, items, promises) were lost
+// once their scenes left the live window. The story state keeps them: the Helper names changes, code applies them,
+// a promise must quote the transcript word for word, and a user's edit survives the next update.
+const directory = mkdtempSync(join(tmpdir(), "marinara-story-state-"));
+process.env.DATA_DIR = directory;
+process.env.FILE_STORAGE_DIR = join(directory, "storage");
+process.env.NODE_ENV = "test";
+process.env.LOG_LEVEL = "silent";
+process.env.MARINARA_LITE = "true";
+
+const storyRequests: string[] = [];
+const provider = createServer(async (request, response) => {
+  const chunks: Buffer[] = [];
+  for await (const chunk of request) chunks.push(Buffer.from(chunk));
+  const body = JSON.parse(Buffer.concat(chunks).toString());
+  response.setHeader("content-type", "application/json");
+  if (request.url === "/v1/systemone") {
+    const answers = Object.fromEntries(
+      Object.entries(body.questions).map(([id, value]) => {
+        const message = body.state.transcript?.find((item: { messageId: string }) => item.messageId === id);
+        const cut = (value as { instructions: string }).instructions.includes("cut to a new scene");
+        return [id, { type: "noul", noul: cut && message?.content.startsWith("SCENE_CHANGE") ? 0.99 : 0.01 }];
+      }),
+    );
+    response.end(JSON.stringify({ answers }));
+    return;
+  }
+  const system = String(body.messages?.[0]?.content ?? "");
+  const user = String(body.messages?.at(-1)?.content ?? "");
+  let content = JSON.stringify({ audience: "all", summary: "Mari and Kaito travelled on." });
+  if (system.startsWith("You keep the story state")) {
+    storyRequests.push(user);
+    content = JSON.stringify(
+      user.includes("Edited: Mari rests at the river camp.")
+        ? {
+            remove: [],
+            replace: [{ old: "Edited: Mari rests at the river camp.", new: "Mari walks on with a limp." }],
+            add: [{ section: "Threads", line: "The bridge toll is still unpaid." }],
+          }
+        : {
+            remove: [],
+            replace: [],
+            add: [
+              { section: "Cast", line: "Mari: at the river camp, ankle sprained." },
+              { section: "Items", line: "Kaito holds the brass lantern." },
+              { section: "Promises", line: 'Kaito promised "I will carry the lantern for you".' },
+              { section: "Promises", line: 'Mari swore "never again, not once".' },
+              { section: "Nonsense", line: "This section does not exist." },
+            ],
+          },
+    );
+  }
+  response.end(JSON.stringify({ choices: [{ message: { role: "assistant", content }, finish_reason: "stop" }] }));
+});
+
+const { createFileNativeDB } = await import("../../packages/server/src/db/file-backed-store.js");
+const { createChatsStorage } = await import("../../packages/server/src/services/storage/chats.storage.js");
+const { createConnectionsStorage } = await import("../../packages/server/src/services/storage/connections.storage.js");
+const { createAdvancedMemoryService } = await import("../../packages/server/src/services/advanced-memory.js");
+const db = await createFileNativeDB();
+const chats = createChatsStorage(db);
+const connections = createConnectionsStorage(db);
+const memory = createAdvancedMemoryService(db);
+
+const long = (label: string) => `${label} ${"Mari and Kaito keep walking along the old river road. ".repeat(40)}`;
+
+try {
+  await new Promise<void>((resolve) => provider.listen(0, "127.0.0.1", resolve));
+  const address = provider.address();
+  assert(address && typeof address === "object");
+  const base = `http://127.0.0.1:${address.port}`;
+  const helper = await connections.create({
+    name: "Summary helper",
+    provider: "custom",
+    baseUrl: `${base}/v1`,
+    model: "summary",
+    apiKey: "fixture",
+    maxContext: 65000,
+  });
+  const decision = await connections.create({
+    name: "Jev",
+    provider: "decision",
+    decisionSource: "custom",
+    baseUrl: base,
+    model: "jev-latest",
+    apiKey: "",
+    maxStateTokens: 30000,
+  });
+  const chat = await chats.create({
+    name: "Story state",
+    mode: "roleplay",
+    characterIds: ["kaito"],
+    connectionId: helper.id,
+  });
+  assert(chat);
+  await memory.updateSettings(chat.id, {
+    enabled: true,
+    maxContextTokens: 12000,
+    summaryBudgetTokens: 2500,
+    sceneCheckInterval: 4,
+    decisionEnabled: true,
+    decisionConnectionId: decision.id,
+    knowledgeStarts: { kaito: null },
+    knowledgeConfirmed: true,
+  });
+  const scene = (index: number, extra = "") => [
+    { role: "user" as const, content: long(`SCENE_CHANGE Scene ${index} opens.`) },
+    { role: "assistant" as const, characterId: "kaito", content: long(`Kaito answers in scene ${index}.${extra}`) },
+    { role: "user" as const, content: long(`Mari replies in scene ${index}.`) },
+  ];
+  await chats.createMessagesBatch(chat.id, [
+    ...scene(0, ' "I will carry the lantern for you," Kaito says.'),
+    ...[1, 2, 3, 4, 5].flatMap((index) => scene(index)),
+  ]);
+  await memory.initialize(chat.id);
+  const cut = async () => {
+    const source = await chats.listMessages(chat.id);
+    await memory.checkScenesAfterGeneration(chat.id, {
+      maxRequestInputTokens: 12000,
+      asOfMessageId: source.at(-1)!.id,
+    });
+    return source;
+  };
+  const stateOf = async () => (await memory.status(chat.id)).job.storyState;
+
+  // The first cut fills the story state from the archived messages.
+  const source = await cut();
+  const start = (await memory.status(chat.id)).job.contextStarts?.[0]?.messageId;
+  assert.ok(start, "an input at the cap saves a cutoff");
+  const first = await stateOf();
+  assert.ok(first, "the story state is filled once messages leave the live window");
+  assert.equal(
+    first.throughMessageId,
+    source[source.findIndex((message) => message.id === start) - 1]!.id,
+    "it covers the archived history up to the cutoff",
+  );
+  assert.equal(
+    first.content,
+    [
+      "Cast:",
+      "- Mari: at the river camp, ankle sprained.",
+      "Items:",
+      "- Kaito holds the brass lantern.",
+      "Promises:",
+      '- Kaito promised "I will carry the lantern for you".',
+    ].join("\n"),
+    "known sections are applied in order, an unquoted promise and an unknown section are dropped",
+  );
+  assert.equal(storyRequests.length, 1);
+  assert.ok(storyRequests[0]!.includes("Current story state:\n(empty)"), "the first update starts empty");
+
+  // A prompt shows it after the recaps, and a swipe of an older message does not.
+  const prepared = await memory.prepare({
+    chatId: chat.id,
+    messages: source,
+    audienceCharacterIds: ["kaito"],
+    budgetTokens: 11000,
+  });
+  assert.ok(prepared.chatSummary?.endsWith(first.content), "the prompt carries the story state");
+  assert.ok(prepared.chatSummary?.includes("Story state at the end of the archived history"), "under its heading");
+  const older = await memory.prepare({
+    chatId: chat.id,
+    messages: source.slice(0, 3),
+    audienceCharacterIds: ["kaito"],
+    budgetTokens: 11000,
+  });
+  assert.ok(
+    !older.chatSummary?.includes("Story state"),
+    "a prompt that ends before the covered messages leaves it out",
+  );
+
+  // A user's edit is kept, and the next update builds on it while copying untouched lines exactly.
+  await memory.setStoryState(
+    chat.id,
+    "Cast:\n- Edited: Mari rests at the river camp.\nWorld:\n- The river floods at dusk.",
+  );
+  assert.equal((await stateOf())?.throughMessageId, first.throughMessageId, "an edit keeps the covered range");
+  for (const message of [...scene(6), ...scene(7), ...scene(8)])
+    await chats.createMessage({ chatId: chat.id, ...message });
+  await cut();
+  const second = await stateOf();
+  assert.equal(storyRequests.length, 2, "the next cut updates the story state again");
+  assert.ok(storyRequests[1]!.includes("Edited: Mari rests at the river camp."), "the update reads the user's edit");
+  assert.equal(
+    second?.content,
+    [
+      "Cast:",
+      "- Mari walks on with a limp.",
+      "Threads:",
+      "- The bridge toll is still unpaid.",
+      "World:",
+      "- The river floods at dusk.",
+    ].join("\n"),
+    "the replaced line changes and the untouched World line stays as written",
+  );
+  assert.notEqual(second?.throughMessageId, first.throughMessageId, "the covered range moves with the cutoff");
+
+  // Clearing and resetting both remove it.
+  await memory.setStoryState(chat.id, "   ");
+  assert.equal((await stateOf()) ?? null, null, "empty text clears the story state");
+  await memory.setStoryState(chat.id, "Cast:\n- Kaito waits.");
+  await memory.reset(chat.id);
+  assert.equal((await stateOf()) ?? null, null, "a reset clears the story state");
+  await assert.rejects(memory.setStoryState(chat.id, "x".repeat(20_001)), /at most 20,000 characters/u);
+  console.log("advanced memory story state regression passed");
+} finally {
+  provider.close();
+  rmSync(directory, { recursive: true, force: true });
+}
